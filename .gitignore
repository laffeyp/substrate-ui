# Generated run records — demo_* are reproducible via gen_demo_records.py;
# launch_*/build_*/resume_* are transient test/server output. None are source.
runs/*.record/
runs/*.record

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Node — the E2E harness deps are pinned by package-lock.json (committed); node_modules is not.
node_modules/

# Vite build output — regenerated by `npm run build`; served by server.py from web/dist/.
web/dist/

# Electron main compiled from electron/*.ts by `tsc -p electron` (npm run build).
dist-main/

# Perceptual-capture output — regenerated by `npm run capture`; viewed, not versioned.
screenshots/

# Sprint 031 optional signal-tail fixtures — written only when CAPTURE_SIGNALS=1 is set on an
# e2e run. Diagnostic seam, not a contract. The canonical fixtures at captures/sprint-021/ ARE
# versioned (the grader reads them); the e2e-*.jsonl fixtures are not.
captures/e2e-*.jsonl

# OS
.DS_Store

# archived run records (runtime artifacts, not source)
runs/.archive-*/

# aider's per-invocation chat log (Sprint 084 CLI probes wrote one)
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v*

# Sprint 089 packaging outputs
build/python/
dist-electron/
dist-electron-*/
.env.local
build/python-native/

# release.sh's per-run logs and gate reports (UI sprint 107: they were untracked noise; the
# release's own clean-tree check already skipped them)
runs/packaged/release-*
# the shakeout harness's server log, written next to each run's report.json
captures/shakeout-*/server.log
harness/shakeout/.scratch/

# Pixel gate (sprint 195): the baseline is kept; check runs are not.
captures/pixel/*
!captures/pixel/baseline-*/

# Gate screenshot runs (editor sprints 403+) and the design frames render_frames.ts draws from the sheet:
# check runs, regenerated by their gates and the renderer; not kept.
runs/packaged/sprint-*/
runs/design/
