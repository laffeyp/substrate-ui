<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Minimum entitlements for a hardened-runtime Electron .app that
      bundles a Python interpreter and spawns it as a child process.
      Apple notarization requires hardened runtime; hardened runtime
      blocks JIT and unsigned executable memory unless the following
      are explicitly granted.
    -->

    <!-- V8's TurboFan compiler writes executable pages at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Node's ffi and Electron's built-in modules occasionally map
         unsigned executable memory. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- The bundled Python interpreter is signed with this app's cert
         but loads .so extension modules also signed with this app's
         cert. This entitlement is what lets an .app spawn a Python
         child that dlopen()s .so files. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>

    <!-- Python's importlib and site-packages load .so binaries from
         inside the .app's Resources folder. Disable library validation
         so the interpreter can load extension modules whose team-id
         differs from the .app's. Python-build-standalone binaries are
         signed by Astral, not the .app's identity. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- The user picks arbitrary workspaces on disk; the substrate
         server reads and writes there. Sandbox stays off (this is a
         developer tool, not a Mac App Store submission). -->

    <!-- Network access — the daemon binds 127.0.0.1 and talks to
         Ollama, Anthropic, OpenAI. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
