#!/usr/bin/env bash
# Pre-commit hook: block any commit that would land a tsc error.
# Ratified 2026-08-29 (Architect: zero tsc errors baseline).
#
# Wired via `git config core.hooksPath .githooks` (see .githooks/README.md).
# The hook runs `npm run typecheck` (which is `tsc --noEmit`) from the
# substrate-ui directory. On failure it prints the error list and exits
# non-zero, aborting the commit. Fix the errors and re-commit.
#
# To bypass in a genuine emergency: `git commit --no-verify`. Do so only
# when you have already run `npm run typecheck` and know the failure is
# in code you are not committing. Every such use is a red flag.

set -euo pipefail

# Resolve the repo root by walking up from the hook location.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$HOOK_DIR/.." && pwd)"

cd "$REPO_ROOT"

if ! [ -f package.json ]; then
  echo "[pre-commit] no package.json at $REPO_ROOT — skipping typecheck" >&2
  exit 0
fi

echo "[pre-commit] running typecheck..." >&2
if ! npm run --silent typecheck; then
  echo "" >&2
  echo "[pre-commit] BLOCKED — tsc reported errors. Fix them or --no-verify at your peril." >&2
  exit 1
fi
echo "[pre-commit] typecheck clean." >&2
