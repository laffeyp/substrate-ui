{
  "name": "substrate-ui-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Live end-to-end test harness for the substrate-ui console — drives the real console in real Chrome (Playwright channel:'chrome') against the real server. The observation contract's tooling, scoped to this repo and pinned by package-lock.json so it is reproducible, not an ad-hoc /tmp install.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "e2e": "node harness/e2e_console.js",
    "e2e:studio": "node harness/e2e_studio.js",
    "e2e:assay": "node harness/e2e_assay.js",
    "e2e:delegate": "node harness/e2e_delegate.js",
    "capture:delegate": "node harness/capture_delegate.js",
    "capture": "node harness/capture_console.js",
    "capture:states": "node harness/capture_states.js",
    "capture:studio": "node harness/capture_studio.js",
    "capture:scene": "node harness/capture_scene.js",
    "capture:signals": "node harness/capture_signals.js 021",
    "capture:studio-signals": "node harness/capture_studio_signals.js",
    "grade:signals": "npx tsx tools/capture-grade.ts captures/sprint-021/console.jsonl",
    "grade:studio-signals": "npx tsx tools/capture-grade.ts captures/sprint-021/studio.jsonl --kind studio",
    "check:vocab-parity": "npx tsx tools/check-vocabulary-parity.ts",
    "capture:view-toggle": "node harness/capture_view_toggle.js",
    "capture:terminal-session": "node harness/capture_terminal_session.js",
    "grade:terminal-session": "npx tsx tools/capture-grade.ts captures/sprint-035/terminal-session.jsonl --kind session",
    "check:tsc-new": "npx tsc --noEmit 2>&1 | grep -E '(view-ids|observability|state|terminal|rail|capture-grade|check-vocabulary-parity|sync-substrate-vocab)\\.ts' && exit 1 || exit 0",
    "capture:terminal-slash-router": "node harness/capture_terminal_slash_router.js",
    "capture:terminal-driver-picker": "node harness/capture_terminal_driver_picker.js",
    "capture:terminal-interrupt": "node harness/capture_terminal_interrupt.js",
    "capture:terminal-params-drawer": "node harness/capture_terminal_params_drawer.js",
    "capture:terminal-create-controls": "node harness/capture_terminal_create_controls.js",
    "capture:rail-four-buckets": "node harness/capture_rail_four_buckets.js",
    "signals": "npm run check:vocab-parity && npm run check:tsc-new && npm run capture:signals && npm run grade:signals && npm run capture:studio-signals && npm run grade:studio-signals && npm run capture:view-toggle && npm run capture:terminal-session && npm run grade:terminal-session && npm run capture:terminal-slash-router && npm run capture:terminal-driver-picker && npm run capture:terminal-interrupt && npm run capture:terminal-params-drawer && npm run capture:terminal-create-controls && npm run capture:rail-four-buckets",
    "sync:substrate-vocab": "npx tsx tools/sync-substrate-vocab.ts",
    "e2e:terminal-v1": "node _deprecated/terminal-v1-round1/harness/e2e_terminal_v1.js",
    "capture:terminal-v1": "node _deprecated/terminal-v1-round1/harness/capture_terminal_v1.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "playwright": "^1.49.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "^5"
  }
}
