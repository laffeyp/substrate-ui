{
  "name": "substrate-ui",
  "version": "0.1.0",
  "description": "The substrate desktop shell. Renders Prototype v7 as a real Electron desktop app; substrate runs in-process via a Python bridge.",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "bridge": "python3 bridge/main.py",
    "gen:tags": "node scripts/gen-tags.mjs",
    "prebuild": "node scripts/gen-tags.mjs",
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "harness:boot": "node tests/harness/e2e_boot.js",
    "harness:first-pane": "node tests/harness/e2e_first_pane.js"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "electron": "^30.0.9",
    "esbuild": "~0.24.0",
    "playwright": "^1.63.0",
    "typescript": "~5.6.3"
  }
}
