+
+// Sprint 391 — directory listing for the editor's file tree. The renderer calls
+// window.native.listDir(workspace, dirPath) and main reads the directory, returning
+// { name, type, size }[] for each entry. The listed path must resolve under the workspace
+// root; anything else returns an empty array. Truncated at 20,000 entries.
+const DIR_CAP = 20_000;
+ipcMain.handle("native:list-dir", async (_event, workspace: string, dirPath: string) => {
+  try {
+    const root = path.resolve(workspace);
+    const target = path.resolve(dirPath);
+    if (!target.startsWith(root + path.sep) && target !== root) return { entries: [], truncated: false };
+    const names = await fs.promises.readdir(target, { withFileTypes: true });
+    const truncated = names.length > DIR_CAP;
+    const slice = truncated ? names.slice(0, DIR_CAP) : names;
+    const entries: { name: string; type: "file" | "directory"; size: number }[] = [];
+    for (const d of slice) {
+      const full = path.join(target, d.name);
+      let size = 0;
+      if (d.isFile()) {
+        try { size = (await fs.promises.stat(full)).size; } catch { /* unreadable */ }
+      }
+      entries.push({ name: d.name, type: d.isDirectory() ? "directory" : "file", size });
+    }
+    return { entries, truncated };
+  } catch {
+    return { entries: [], truncated: false };
+  }
+});
+
+// Sprint 393 — diff vs main for the editor's modified dots. Returns the list of files
+// changed relative to the merge-base of the default branch, using a scratch index so
+// untracked files appear. For workspaces with no git or no main branch, returns [].
+ipcMain.handle("native:diff-vs-main", async (_event, workspace: string) => {
+  try {
+    const root = path.resolve(workspace);
+    const gitDir = path.join(root, ".git");
+    try { await fs.promises.access(gitDir); } catch { return { files: [] }; }
+
+    const git = async (...args: string[]) => {
+      const { stdout } = await execFileAsync("git", args, { cwd: root, maxBuffer: 10 * 1024 * 1024 });
+      return stdout.trim();
+    };
+
+    // Find the default branch: try main, then master, then HEAD's symbolic ref.
+    let defaultBranch = "main";
+    try { await git("rev-parse", "--verify", "main"); } catch {
+      try { await git("rev-parse", "--verify", "master"); defaultBranch = "master"; } catch {
+        try { defaultBranch = await git("symbolic-ref", "--short", "HEAD"); } catch {
+          return { files: [] };
+        }
+      }
+    }
+
+    // Merge-base between the default branch and HEAD.
+    let base: string;
+    try { base = await git("merge-base", defaultBranch, "HEAD"); } catch {
+      // No merge-base (orphan branch, only one commit, or HEAD is the default branch).
+      // Fall back to diffing the entire tree against an empty tree.
+      base = await git("hash-object", "-t", "tree", "/dev/null");
+    }
+
+    // Use a scratch index so untracked files show in the diff without modifying the real index.
+    const tmpDir = path.join(os.tmpdir(), `substrate-diff-${Date.now()}`);
+    await fs.promises.mkdir(tmpDir, { recursive: true });
+    const scratchIndex = path.join(tmpDir, "index");
+    const realIndex = path.join(root, ".git", "index");
+    try { await fs.promises.copyFile(realIndex, scratchIndex); } catch { /* no index yet */ }
+
+    const gitEnv = { ...process.env, GIT_INDEX_FILE: scratchIndex };
+    const gitScratch = async (...args: string[]) => {
+      const { stdout } = await execFileAsync("git", args, { cwd: root, maxBuffer: 10 * 1024 * 1024, env: gitEnv });
+      return stdout.trim();
+    };
+
+    await gitScratch("add", "-A", "--intent-to-add");
+    const nameStatus = await gitScratch("diff", "--name-status", base);
+
+    // Cleanup scratch index.
+    await fs.promises.rm(tmpDir, { recursive: true, force: true }).catch(() => {});
+
+    const files: { path: string; status: string }[] = [];
+    for (const line of nameStatus.split("\n")) {
+      if (!line) continue;
+      const tab = line.indexOf("\t");
+      if (tab === -1) continue;
+      files.push({ path: line.slice(tab + 1), status: line.slice(0, tab) });
+    }
+    return { files };
+  } catch {
+    return { files: [] };
+  }
+});
